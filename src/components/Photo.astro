---
import type { Photo } from '../lib/photos';
interface Props {
  photo: Photo;
  priority?: boolean;
  sizes?: string;
  caption?: boolean;
  alt?: string;
  captionText?: string;
  creditsLabel?: string;
  aiIllustrationLabel?: string;
  creditsHref?: string;
  class?: string;
}
const { photo, priority = false, sizes = '(max-width: 760px) 100vw, 800px', caption = true, alt, captionText, creditsLabel = 'Image credits and edits', aiIllustrationLabel = 'AI illustration', creditsHref = '/photo-credits/', class: className = '' } = Astro.props;
---
<figure class:list={['photo', className]}>
  <picture>
    <source type="image/webp" srcset={photo.srcSet} sizes={sizes} />
    <img src={photo.fallbackSrc} alt={alt ?? photo.alt} width={photo.width} height={photo.height} loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : undefined} />
  </picture>
  {(caption || photo.kind === 'illustration') && <figcaption class="photo-caption">
    {photo.kind === 'illustration' ? <strong>{aiIllustrationLabel}. </strong> : null}
    {captionText ?? photo.caption} <a href={photo.sourceUrl} rel="noopener">{photo.author}</a> · <a href={photo.licenseUrl} rel="license noopener">{photo.license}</a>. <a href={`${creditsHref}#${photo.id}`}>{creditsLabel}</a>.
  </figcaption>}
</figure>
