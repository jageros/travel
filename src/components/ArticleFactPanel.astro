---
import { formatDate } from '../lib/content';
import type { articleFacts } from '../lib/sources';

interface Props {
  facts: ReturnType<typeof articleFacts>;
  title: string;
}

const { facts, title } = Astro.props;
---

{facts.length > 0 && <section class="fact-panel" aria-label="Source-checked facts">
  <h2>{title}</h2>
  <ul>{facts.map(({ fact, source, status }) => <li>
    {status === 'current' && <div data-current-fact data-fact-checked={fact.checkedAt} data-fact-expires={fact.expiresAt || ''} hidden>
      <p>{fact.statement}</p>
      <small>Checked {formatDate(fact.checkedAt)}{fact.expiresAt && ` · Recheck by ${formatDate(fact.expiresAt)}`}</small>
    </div>}
    <p data-fact-fallback>This detail needs a fresh check before you rely on it. Consult the official provider for its current rules.</p>
    <a href={source.url} rel="noopener">{source.publisher}: {source.title} ↗</a>
  </li>)}</ul>
</section>}
