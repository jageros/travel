---
import { SITE_NAME } from '../lib/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { getPhoto, photoRecords } from '../lib/photos';
import { visibleArticles } from '../lib/content';
const creditedIds = new Set(['golden-gate', 'city-cable-car', 'bart-train', 'muni-streetcar', 'sfo-bart']);
for (const { data } of await visibleArticles()) {
  if (data.hero && 'photoId' in data.hero) creditedIds.add(data.hero.photoId);
}
const images = await Promise.all(photoRecords.filter(record => creditedIds.has(record.id))
  .map(async record => ({ record, photo: await getPhoto(record.id) })));
---
<BaseLayout title={`Image credits — ${SITE_NAME}`} description="Creators, sources and reuse terms for images used on Cedar Trips." path="/photo-credits/" breadcrumbs={[{name:'Home',url:'/'},{name:'Image credits',url:'/photo-credits/'}]}>
  <section class="container section-block">
    <div class="page-intro"><h1>Image credits</h1><p>Find the creator, original source and reuse terms for each image.</p></div>
    <p>We resize and compress images for this site and may crop them for cards and social previews. Adapted photographs retain the license listed for each image, including ShareAlike terms where indicated. Use the official references on each destination page to check current conditions.</p>
    <div class="photo-credits-grid">{images.map(({ photo, record }) => <article class="photo-credit-card" id={photo.id}>
      <Photo photo={photo} sizes="(max-width: 760px) 100vw, 560px" />
      <h2>{record.title}</h2>
      {record.generation && <p>Created with {record.generation.provider} on <time datetime={record.generation.generatedAt}>{record.generation.generatedAt}</time>. Prompt summary: {record.generation.promptSummary}.</p>}
      {record.permissionNote && <p>{record.permissionNote}</p>}
      <p>{record.capturedAt && <>Photographed <time datetime={record.capturedAt}>{record.capturedAt}</time>. </>}Source and rights checked <time datetime={record.checkedAt}>{record.checkedAt}</time>.</p>
      <a href={photo.sourceUrl} rel="noopener">View source record ↗</a>
    </article>)}</div>
  </section>
</BaseLayout>
