---
import { SITE_NAME } from '../../lib/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { topics, getTopic, visibleArticles, articleHref, sanFranciscoTopic } from '../../lib/content';
import { getArticlePhoto } from '../../lib/photos';

export function getStaticPaths() {
  return topics.filter(topic => topic.href.startsWith('/topics/')).map(topic => ({ params: { slug: topic.slug } }));
}
const topic = getTopic(Astro.params.slug!);
const articles = (await visibleArticles()).filter(article => article.data.topic === topic.slug);
const cards = await Promise.all(articles.map(async article => ({ article, image: await getArticlePhoto(article.data.hero) })));
---

<BaseLayout title={`${topic.title} — ${SITE_NAME}`} description={topic.description} path={topic.href} breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Topics', url: '/topics/' }, { name: topic.title, url: topic.href }]} noindex={articles.length === 0}>
  <section class="container section-block">
    <div class="page-intro"><p class="eyebrow">{topic.region}</p><h1>{topic.title}</h1><p>{topic.description}</p></div>
    {topic.slug === sanFranciscoTopic.slug && <div class="topic-editorial prose">
      <p>Start by working out where you’ll arrive and where you’re staying. Then use the guides below to plan the airport transfer, compare tickets and choose a way to reach the sights. Check current service with <a href="https://www.sfmta.com/getting-around/muni" rel="noopener">SFMTA</a> and <a href="https://www.bart.gov/guide/airport/sfo" rel="noopener">BART</a> before heading out.</p>
    </div>}
    {cards.length > 0 && <div class="cards-grid">
      {cards.map(({ article, image }) => <Card title={article.data.title} description={article.data.description} href={articleHref(article)} type={article.data.type} topic={topic.title} image={image} />)}
    </div>}
  </section>
</BaseLayout>
