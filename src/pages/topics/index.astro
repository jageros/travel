---
import { SITE_NAME } from '../../lib/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { topics } from '../../lib/content';
---

<BaseLayout title={`Travel topics — ${SITE_NAME}`} description="Discover places to visit across the United States and plan car-free travel in San Francisco." path="/topics/" breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Topics', url: '/topics/' }]}>
  <section class="container section-block">
    <div class="page-intro"><h1>Travel topics</h1></div>
    <div class="topic-grid topic-directory">
      {topics.map(topic => <a class="topic-card" href={topic.href}>
        <span class="card-type">{topic.region}</span>
        <h2>{topic.title}</h2>
        <p>{topic.description}</p>
        <span class="topic-link">Explore <span aria-hidden="true">→</span></span>
      </a>)}
    </div>
  </section>
</BaseLayout>
