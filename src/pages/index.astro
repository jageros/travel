---
import BaseLayout from '../layouts/BaseLayout.astro';
import DestinationGrid from '../components/DestinationGrid.astro';
import HomeHero from '../components/HomeHero.astro';
import { articleHref, destinationArticles, destinationTopic, recentDestinations, sanFranciscoTopic, visibleArticles } from '../lib/content';
import { localeCopy } from '../lib/i18n-copy.mjs';
import { getArticlePhoto, getPhoto } from '../lib/photos';
import { SITE_NAME } from '../lib/site';

const articles = await visibleArticles();
const destinations = recentDestinations(destinationArticles(articles));
const hero = destinations.find(({ article }) => article.data.hero && 'photoId' in article.data.hero);
const recent = destinations.filter(entry => entry !== hero).slice(0, 8);
const heroPhoto = await getArticlePhoto(hero?.article.data.hero) ?? await getPhoto('golden-gate');
const text = localeCopy('en-US');
---

<BaseLayout title={`Places worth visiting in the United States — ${SITE_NAME}`} description="Find your next U.S. destination, from national parks and city landmarks to gardens, museums and space exhibits." path="/" socialImage={{ ...heroPhoto.share, alt: heroPhoto.alt }}>
  <HomeHero
    label={hero ? text.latest : text.explore}
    title={hero?.details.title ?? text.homeTitle}
    description={hero?.details.reason ?? text.homeDescription}
    href={hero ? articleHref(hero.article) : destinationTopic.href}
    action={hero ? text.readGuide : 'Explore destinations'}
    destination={Boolean(hero)}
    image={{ photo: heroPhoto }}
  />

  {recent.length > 0 && <section class="container section-block homepage-destinations" aria-labelledby="recent-destinations">
    <div class="section-heading">
      <h2 id="recent-destinations">{text.recent}</h2>
      <a href={destinationTopic.href}>{text.viewAll} <span aria-hidden="true">→</span></a>
    </div>
    <DestinationGrid destinations={recent} />
  </section>}

  <section class="container section-block" aria-labelledby="san-francisco-topic">
    <div class="editorial-banner discovery-topic">
      <h2 id="san-francisco-topic">{sanFranciscoTopic.title}</h2>
      <div>
        <p>{sanFranciscoTopic.description}</p>
        <a href={sanFranciscoTopic.href}>Explore the San Francisco guides <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
