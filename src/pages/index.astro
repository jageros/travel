---
import BaseLayout from '../layouts/BaseLayout.astro';
import DestinationGrid from '../components/DestinationGrid.astro';
import Photo from '../components/Photo.astro';
import { destinationArticles, destinationTopic, sanFranciscoTopic, visibleArticles } from '../lib/content';
import { getArticlePhoto, getPhoto } from '../lib/photos';
import { SITE_NAME } from '../lib/site';

const articles = await visibleArticles();
const destinations = destinationArticles(articles);
const featured = destinations.filter(({ details }) => details.featured);
const featuredArticles = (featured.length ? featured : destinations).slice(0, 8).map(({ article }) => article);
const hero = destinations.find(({ article }) => article.data.slug === 'grand-canyon') ?? destinations[0];
const heroPhoto = await getArticlePhoto(hero?.article.data.hero) ?? await getPhoto('golden-gate');
const heroSizes = heroPhoto.width / heroPhoto.height > 2.25
  ? '(max-width: 700px) calc(200vw - 72px), (max-width: 1000px) 132vw, 1600px'
  : '(max-width: 700px) calc(100vw - 36px), (max-width: 1000px) 56vw, 680px';
---

<BaseLayout title={`Places worth visiting in the United States — ${SITE_NAME}`} description="Find your next U.S. destination, from national parks and city landmarks to gardens, museums and space exhibits." path="/" socialImage={{ ...heroPhoto.share, alt: heroPhoto.alt }}>
  <section class="container discovery-hero">
    <div class="discovery-hero-copy">
      <p class="eyebrow">Explore the United States</p>
      <h1>Places worth<br class="discovery-break" /> the trip.</h1>
      <p>Discover canyons, city landmarks and places worth a detour. Find out what to see and what to check before you go.</p>
      <a class="button" href={destinationTopic.href}>Explore destinations <span aria-hidden="true">↗</span></a>
    </div>
    <Photo photo={heroPhoto} priority sizes={heroSizes} class="discovery-hero-photo" />
  </section>

  {featuredArticles.length > 0 && <section class="container section-block homepage-destinations" aria-labelledby="featured-destinations">
    <div class="section-heading">
      <h2 id="featured-destinations">Featured destinations</h2>
      <a href={destinationTopic.href}>View all destinations <span aria-hidden="true">→</span></a>
    </div>
    <DestinationGrid articles={featuredArticles} />
  </section>}

  <section class="container section-block" aria-labelledby="san-francisco-topic">
    <div class="editorial-banner discovery-topic">
      <h2 id="san-francisco-topic">{sanFranciscoTopic.title}</h2>
      <div>
        <p>{sanFranciscoTopic.description}</p>
        <a href={sanFranciscoTopic.href}>Explore the San Francisco guides <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
