{
  "name": "cedar-trips",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test tests/*.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "sources:check": "node scripts/check-sources.mjs",
    "content:draft": "node scripts/content-pipeline.mjs --draft",
    "content:publish": "node scripts/content-pipeline.mjs --publish",
    "verify:build": "node scripts/verify-build.mjs",
    "verify": "npm run validate:content && npm run check && npm test && npm run build && npm run verify:build",
    "metrics:report": "node scripts/report-metrics.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/react": "7.0.0",
    "astro": "7.4.0",
    "mdast-util-from-markdown": "2.1.0",
    "oxc-transform-react": "^0.145.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.9.3",
    "parse5": "7.3.0"
  },
  "overrides": {
    "@astrojs/react": {
      "@vitejs/plugin-react": "6.1.1"
    }
  }
}
