# Only these PUBLIC values may be shipped to the browser. Never put model/GSC keys here.
PUBLIC_SITE_URL=https://www.cedartrips.com
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_GA_MEASUREMENT_ID=
ADSENSE_READY=false
PUBLIC_CMP_SCRIPT_URL=
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_MID_ARTICLE=
PUBLIC_ADSENSE_SLOT_END_ARTICLE=
PUBLIC_CONTACT_EMAIL=
# Must explicitly opt in after live deployment checks. Review/preview always remain noindex.
SITE_INDEXING_ENABLED=false
CONTENT_REVIEW_PREVIEW=false
# Server/CI only, not PUBLIC. Needed only for optional draft generation.
DRAFT_API_BASE_URL=https://api.openai.com/v1/
DRAFT_API_KEY=
DRAFT_MODEL=
DRAFT_API_ALLOWED_HOSTS=api.openai.com
